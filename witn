      showToast('Perubahan soal berhasil disimpan dan divalidasi ulang.', 'success');
    }

    function duplicateQuestion(soalId) {
      const orig = DB.BANK_SOAL.find(s => s.id === soalId);
      if (!orig) return;
      const copy = JSON.parse(JSON.stringify(orig));
      copy.id = 'SOAL-' + Date.now();
      copy.nomor_soal = DB.BANK_SOAL.length + 1;
      copy.batang_soal = copy.batang_soal + ' (Variasi)';
      DB.BANK_SOAL.push(copy);
      syncRelationalQuestionTables();
