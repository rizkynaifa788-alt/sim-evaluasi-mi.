            <td class="py-2.5 px-3 text-center font-bold">${DB.INDIKATOR.length}</td>
            <td class="py-2.5 px-3 text-center font-bold text-kemenag-700">${DB.BANK_SOAL.length}</td>
            <td class="py-2.5 px-3"><span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold">${validSoal} Valid</span></td>
          </tr>
        `;
      }

      // Log Aktivitas
      const logContainer = document.getElementById('activityLogList');
      if (DB.LOG_AKTIVITAS.length === 0) {
        logContainer.innerHTML = `<div class="py-3 text-center text-slate-400">Belum ada aktivitas tercatat.</div>`;
      } else {
        logContainer.innerHTML = DB.LOG_AKTIVITAS.map(l => `
          <div class="flex items-center justify-between py-1 border-b border-slate-50">
            <div><span class="font-semibold text-kemenag-700">[${l.aksi}]</span> ${l.detail}</div>
            <span class="text-[11px] text-slate-400 shrink-0 ml-2">${l.waktu}</span>
          </div>
        `).join('');
      }

      updateBadges();
    }

    function renderConfigView() {
      const grid = document.getElementById('databaseSheetsGrid');
      const select = document.getElementById('dbInspectorSelect');
      const currentVal = select.value || 'INDIKATOR';

      const gasUrlEl = document.getElementById('cfg_gasUrlInput');
      if (gasUrlEl) gasUrlEl.value = gasWebAppUrl || '';

      grid.innerHTML = REQUIRED_17_SHEETS.map((name, i) => {
        const count = (DB[name] || []).length;
        return `
          <div onclick="document.getElementById('dbInspectorSelect').value='${name}'; renderDatabaseInspector();" class="cursor-pointer p-2.5 rounded-lg border border-slate-200 hover:border-kemenag-500 bg-slate-50/70 flex items-center justify-between text-xs transition">
            <div class="truncate pr-1">
              <span class="text-[10px] text-slate-400 font-mono">${i + 1}.</span>
              <span class="font-mono font-semibold text-slate-800">${name}</span>
            </div>
            <span class="px-1.5 py-0.5 rounded bg-kemenag-100 text-kemenag-800 font-bold text-[10px]">${count}</span>
          </div>
        `;
      }).join('');

      select.innerHTML = REQUIRED_17_SHEETS.map(name => `<option value="${name}" ${name === currentVal ? 'selected' : ''}>${name} (${(DB[name]||[]).length} baris)</option>`).join('');
      renderDatabaseInspector();
    }

    function renderDatabaseInspector() {
      const tableName = document.getElementById('dbInspectorSelect').value || 'INDIKATOR';
      const rows = DB[tableName] || [];
      const container = document.getElementById('dbInspectorTableContainer');

      if (rows.length === 0) {
        container.innerHTML = `<div class="p-6 text-center text-xs text-slate-400">Tabel <code>${tableName}</code> siap digunakan (0 baris).</div>`;
        return;
      }

      const headers = Object.keys(rows[0]).filter(k => k !== 'pilihan' && k !== 'validasi');
      container.innerHTML = `
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-100 border-b border-slate-200 font-mono text-[11px] text-slate-700">
              ${headers.map(h => `<th class="py-2 px-3">${h}</th>`).join('')}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            ${rows.map(r => `
              <tr class="hover:bg-slate-50">
                ${headers.map(h => `<td class="py-2 px-3 max-w-xs truncate">${typeof r[h] === 'object' ? JSON.stringify(r[h]) : r[h]}</td>`).join('')}
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    }

    function saveGasWebAppUrl() {
      const url = document.getElementById('cfg_gasUrlInput').value.trim();
      gasWebAppUrl = url;
      localStorage.setItem(LOCAL_STORAGE_GAS_URL, url);
      if (url) {
        showToast('URL Web App Google Apps Script berhasil dihubungkan! Menyinkronkan data...', 'success');
        saveAllToDatabase(true);
      } else {
        showToast('URL Web App dikosongkan. Aplikasi menggunakan penyimpanan lokal browser.', 'info');
      }
    }

    function initialize17SheetsBackend() {
      if (isGasEnvironment) {
        google.script.run
          .withSuccessHandler(msg => showToast(msg, 'success'))
          .withFailureHandler(err => showToast(err.message, 'error'))
          .initializeDatabaseSheets();
      } else if (gasWebAppUrl) {
        fetch(gasWebAppUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ action: 'INIT_SHEETS' })
        })
          .then(r => r.json())
          .then(res => showToast(res.message || '17 Sheet Google Spreadsheet berhasil diinisialisasi!', 'success'))
          .catch(err => showToast('Gagal menghubungi Web App GAS: ' + err.message, 'error'));
      } else {
        addLog('INIT_17_SHEETS', 'Memverifikasi skema 17 Sheet Database Google Spreadsheet');
        renderConfigView();
        showToast('Seluruh 17 Sheet Database terverifikasi aktif dan siap disinkronkan!', 'success');
      }
    }

    function saveApiKeyToBackend() {
      const key = document.getElementById('cfg_apiKeyInput').value.trim();
      if (!key) {
        showToast('Masukkan API Key terlebih dahulu.', 'warning');
        return;
      }
      runtimeApiKey = key;
      localStorage.setItem(LOCAL_STORAGE_API_KEY, key);

      if (isGasEnvironment) {
        google.script.run
          .withSuccessHandler(() => {
            document.getElementById('cfg_apiKeyInput').value = '';
            showToast('API Key berhasil dienkripsi dan disimpan di PropertiesService backend.', 'success');
          })
          .withFailureHandler(err => {
            showToast('Gagal menyimpan API Key: ' + err.message, 'error');
          })
          .saveApiKeyServer(key);
      } else if (gasWebAppUrl) {
        fetch(gasWebAppUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ action: 'SAVE_API_KEY', apiKey: key })
        }).finally(() => {
          document.getElementById('cfg_apiKeyInput').value = '';
          showToast('API Key berhasil disimpan di Browser & PropertiesService Google Apps Script.', 'success');
        });
      } else {
        document.getElementById('cfg_apiKeyInput').value = '';
        addLog('UPDATE_API_KEY', 'Menyimpan konfigurasi API Key ke sistem');
        showToast('API Key berhasil disimpan dan siap digunakan untuk Generate Soal MI.', 'success');
      }
    }

    function saveAllToDatabase(notify = true) {
      // Selalu simpan cadangan ke localStorage (Berguna saat deploy di Vercel)
      try {
        localStorage.setItem(LOCAL_STORAGE_DB_KEY, JSON.stringify(DB));
      } catch (e) {}

      if (isGasEnvironment) {
        google.script.run
          .withSuccessHandler(() => {
            if (notify) showToast('Seluruh perubahan berhasil disinkronkan ke Google Spreadsheet!', 'success');
          })
          .withFailureHandler(err => {
            if (notify) showToast('Gagal menyimpan ke Spreadsheet: ' + err.message, 'error');
          })
          .syncAllDatabaseTablesServer(DB);
      } else if (gasWebAppUrl) {
        fetch(gasWebAppUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ action: 'SYNC_DB', dbPayload: DB })
        })
          .then(r => r.json())
          .then(() => {
            if (notify) showToast('Data berhasil disinkronkan dari Vercel ke 17 Sheet Google Spreadsheet!', 'success');
          })
          .catch(err => {
            if (notify) showToast('Tersimpan di browser lokal (Gagal sinkron ke URL GAS: ' + err.message + ')', 'warning');
          });
      } else if (notify) {
        addLog('SYNC_DATABASE', 'Menyinkronkan seluruh 17 tabel relasional ke Database');
        showToast('Seluruh data Kisi-Kisi, Bank Soal, dan Paket Ujian MI berhasil disimpan!', 'success');
      }
    }

    /* ==========================================
       INISIALISASI AWAL SAAT HALAMAN DIMUAT (MENDUKUNG GAS & VERCEL)
       ========================================== */
    window.onload = function() {
      // Muat cadangan lokal terlebih dahulu jika ada
      try {
        const savedLocal = localStorage.getItem(LOCAL_STORAGE_DB_KEY);
        if (savedLocal) {
          const parsed = JSON.parse(savedLocal);
          REQUIRED_17_SHEETS.forEach(sheet => {
            if (Array.isArray(parsed[sheet]) && parsed[sheet].length > 0) {
              DB[sheet] = parsed[sheet];
            }
          });
        }
      } catch (e) {}

      if (isGasEnvironment) {
        google.script.run
          .withSuccessHandler(serverData => {
            if (serverData && typeof serverData === 'object') {
              REQUIRED_17_SHEETS.forEach(sheet => {
                if (Array.isArray(serverData[sheet]) && serverData[sheet].length > 0) {
                  DB[sheet] = serverData[sheet];
                }
              });
            }
            loadIdentitasToForm();
            renderKisiTable();
            renderDashboard();
          })
          .withFailureHandler(err => {
            showToast('Gagal memuat database dari Google Spreadsheet: ' + err.message, 'error');
          })
          .loadAllDatabaseTablesServer();
      } else if (gasWebAppUrl) {
        fetch(gasWebAppUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ action: 'LOAD_DB' })
        })
          .then(r => r.json())
          .then(res => {
            const serverData = res.data;
            if (serverData && typeof serverData === 'object') {
              REQUIRED_17_SHEETS.forEach(sheet => {
                if (Array.isArray(serverData[sheet]) && serverData[sheet].length > 0) {
                  DB[sheet] = serverData[sheet];
                }
              });
            }
          })
          .catch(() => {})
          .finally(() => {
            loadIdentitasToForm();
            renderKisiTable();
            renderDashboard();
          });
      } else {
        loadIdentitasToForm();
        renderKisiTable();
        renderDashboard();
      }
    };
  </script>
</body>
</html>
