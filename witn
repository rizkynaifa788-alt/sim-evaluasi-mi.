    /**
     * Memanggil Gemini API (atau Backend GAS) untuk Menurunkan Indikator Soal Secara Nyata dari TP Khusus MI
     */
    async function callGeminiAPIForIndicators(idm, targetCount, singleRowContext = null) {
      if (isGasEnvironment) {
        return new Promise((resolve, reject) => {
          google.script.run
            .withSuccessHandler(res => resolve(res))
            .withFailureHandler(err => reject(err))
            .generateIndicatorsFromTPServer(idm, targetCount, singleRowContext);
        });
      }

      // Jika di Vercel & terhubung ke GAS Web App URL namun belum isi API Key di browser
      if (gasWebAppUrl && !runtimeApiKey) {
        const res = await fetch(gasWebAppUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ action: 'GENERATE_INDICATORS', identitas: idm, targetCount, singleRowContext })
        });
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        return data.result;
      }

      const miGuidance = getMILanguageGuidance(idm.kelas);

      const systemPrompt = `Anda adalah Ahli Evaluasi Pendidikan Dasar (Madrasah Ibtidaiyah / MI) dan Pakar Kurikulum Madrasah Kementerian Agama RI.
Tugas Anda adalah merumuskan INDIKATOR SOAL yang operasional, terukur, sederhana, dan sesuai dengan perkembangan kognitif anak tingkat Madrasah Ibtidaiyah (MI) berdasarkan Capaian Pembelajaran (CP), Tujuan Pembelajaran (TP), dan Materi Pokok yang diberikan guru.

${miGuidance}

KAIDAH WAJIB PENYUSUNAN INDIKATOR SOAL TINGKAT MI (FORMAT ABCD):
1. Setiap indikator soal WAJIB diawali dengan Condition/Stimulus yang konkret dan dekat dengan dunia anak MI (contoh: "Disajikan cerita singkat tentang kegiatan sehari-hari di rumah/madrasah...", "Disajikan pernyataan sederhana mengenai...", "Disajikan gambar/contoh perilaku anak...").
2. Dilanjutkan dengan Audience ("peserta didik dapat...") dan Behavior menggunakan Kata Kerja Operasional (KKO) yang sesuai dengan usia anak MI:
   - C1 (Mengingat): menyebutkan, menunjukkan, mengenali.
   - C2 (Memahami): menjelaskan dengan bahasa sederhana, mengelompokkan, membedakan, memberi contoh.
   - C3 (Menerapkan): menentukan, menerapkan dalam kegiatan sehari-hari, menghitung sederhana, mengurutkan.
   - C4 (Menganalisis sederhana tingkat MI): menemukan alasan, memilih sikap yang tepat dari cerita singkat, mengaitkan sebab-akibat sederhana.
   - C5 (Mengevaluasi sederhana tingkat MI): menilai perilaku baik/buruk berdasarkan contoh, memilih tindakan terbaik.
   - C6 (Mencipta sederhana tingkat MI): menyusun kalimat/langkah sederhana.
3. Indikator soal harus berbeda satu sama lain, tidak duplikat, dan menggunakan bahasa yang mudah dipahami guru maupun siswa MI.`;

      const userPrompt = singleRowContext
        ? `Buatkan tepat 1 (satu) rumusan Indikator Soal tingkat Madrasah Ibtidaiyah (MI) yang sangat presisi untuk baris kisi-kisi berikut:
Mata Pelajaran MI: ${idm.mapel}
Kelas/Fase MI: ${idm.kelas}
Kurikulum: ${idm.kurikulum}
Capaian Pembelajaran (CP): ${singleRowContext.cp || idm.cp}
Tujuan Pembelajaran (TP): ${singleRowContext.tp || idm.tp}
Materi Spesifik: ${singleRowContext.materi || idm.materi_pokok}
Level Kognitif Target: ${singleRowContext.level_kognitif}
Bentuk Soal Target: ${singleRowContext.bentuk_soal}
Nomor Soal: ${singleRowContext.nomor_soal}`
        : `Turunkan dan rumuskan tepat ${targetCount} baris Indikator Soal tingkat Madrasah Ibtidaiyah (MI) untuk kisi-kisi penilaian berikut:
Madrasah Ibtidaiyah: ${idm.nama_madrasah}
Mata Pelajaran MI: ${idm.mapel}
Kelas/Fase MI: ${idm.kelas}
Jenis Penilaian: ${idm.jenis_penilaian}
Kurikulum: ${idm.kurikulum}
Materi Pokok: ${idm.materi_pokok}
Capaian Pembelajaran (CP): ${idm.cp}
Tujuan Pembelajaran (TP): ${idm.tp}
Bentuk Soal Default: ${idm.bentuk_default}

Susun ${targetCount} indikator soal dari nomor soal 1 sampai ${targetCount} dengan distribusi level kognitif yang sesuai untuk siswa ${idm.kelas} (dominan C1, C2, C3 dan pengenalan HOTS sederhana C4) serta total bobot nilai berjumlah 100.`;

      const payload = {
        contents: [{ role: 'user', parts: [{ text: userPrompt }] }],
        systemInstruction: { parts: [{ text: systemPrompt }] },
        generationConfig: {
          responseMimeType: "application/json",
          responseSchema: {
            type: "ARRAY",
            items: {
              type: "OBJECT",
              properties: {
                nomor_soal: { type: "INTEGER" },
                cp: { type: "STRING" },
                tp: { type: "STRING" },
                materi: { type: "STRING" },
                indikator_soal: { type: "STRING" },
                level_kognitif: { type: "STRING" },
                bentuk_soal: { type: "STRING" },
                bobot: { type: "NUMBER" }
              },
              required: ["nomor_soal", "cp", "tp", "materi", "indikator_soal", "level_kognitif", "bentuk_soal", "bobot"]
            }
          }
        }
      };

      const apiKey = runtimeApiKey || "";
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const delays = [1000, 2000, 4000];
      for (let attempt = 0; attempt <= delays.length; attempt++) {
        try {
          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (!response.ok) throw new Error(`Koneksi API AI gagal (HTTP ${response.status}). Pastikan API Key telah dikonfigurasi di menu 7.`);
          const result = await response.json();
          const jsonText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
          if (!jsonText) throw new Error('Respons AI kosong atau batas kuota tercapai.');
          return JSON.parse(jsonText);
        } catch (err) {
          if (attempt === delays.length) throw err;
          await new Promise(r => setTimeout(r, delays[attempt]));
        }
      }
    }

    /**
     * Fungsi Utama: Generate Seluruh Indikator Soal Otomatis dari TP menggunakan AI
     */
    async function triggerAIGenerateIndicatorsFromTP() {
      const idm = DB.IDENTITAS_MADRASAH[0];
      if (!idm || !idm.mapel || !idm.cp || !idm.tp) {
        showToast('Harap isi Mata Pelajaran MI, Capaian Pembelajaran (CP), dan Tujuan Pembelajaran (TP) pada menu 1 terlebih dahulu.', 'warning');
        navigate('identitas');
        return;
      }

      const targetCount = Math.max(1, Math.min(100, parseInt(idm.jumlah_soal) || 10));
      const overlay = document.getElementById('aiLoadingOverlay');
      const titleEl = document.getElementById('aiLoadingTitle');
      const descEl = document.getElementById('aiLoadingDesc');
      const progressBar = document.getElementById('aiProgressBar');
      const progressStep = document.getElementById('aiProgressStep');

      titleEl.textContent = 'AI Sedang Menurunkan Indikator Soal MI dari TP...';
      descEl.textContent = `Menganalisis CP, TP, dan Materi Pokok "${idm.materi_pokok || idm.mapel}" untuk merumuskan ${targetCount} indikator soal ramah anak ${idm.kelas}.`;
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');

      progressBar.style.width = '30%';
      progressStep.textContent = `Menyesuaikan indikator dengan perkembangan kognitif siswa ${idm.kelas}...`;

      try {
        progressBar.style.width = '70%';
        const generatedIndicators = await callGeminiAPIForIndicators(idm, targetCount, null);

        if (!Array.isArray(generatedIndicators) || generatedIndicators.length === 0) {
          throw new Error('AI tidak mengembalikan daftar indikator soal.');
        }

        const defaultBobot = Math.round((100 / generatedIndicators.length) * 10) / 10;

        DB.INDIKATOR = generatedIndicators.map((item, idx) => ({
          id: 'IND-' + Date.now() + '-' + (idx + 1),
          kisi_id: DB.KISI_KISI[0]?.id || 'KISI-001',
          no_urut: idx + 1,
          cp: item.cp || idm.cp,
          tp: item.tp || idm.tp,
          materi: item.materi || idm.materi_pokok || idm.mapel,
          indikator_soal: item.indikator_soal || '',
          level_kognitif: ['C1','C2','C3','C4','C5','C6'].includes(item.level_kognitif) ? item.level_kognitif : 'C2',
          bentuk_soal: item.bentuk_soal || idm.bentuk_default || 'Pilihan Ganda',
          nomor_soal: item.nomor_soal || (idx + 1),
          bobot: Number(item.bobot) || defaultBobot,
          updated_at: new Date().toISOString()
        }));

        progressBar.style.width = '100%';
        renderKisiTable();
        saveAllToDatabase(false);
        addLog('GENERATE_INDIKATOR_AI', `Menghasilkan ${DB.INDIKATOR.length} indikator soal MI otomatis dari TP`);
        showToast(`Berhasil menurunkan ${DB.INDIKATOR.length} Indikator Soal tingkat MI secara nyata dari Tujuan Pembelajaran (TP)!`, 'success');
      } catch (err) {
        addLog('AI_INDIKATOR_ERROR', `Gagal generate indikator dari TP: ${err.message || err}`);
        showToast(`Gagal menghasilkan indikator dari AI: ${err.message || 'Periksa konfigurasi API Key di menu 7.'}`, 'error');
      } finally {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        titleEl.textContent = 'AI Sedang Menyusun Soal Ramah Anak MI...';
        descEl.textContent = 'Menyesuaikan kosakata sederhana tingkat Madrasah Ibtidaiyah (MI), ilustrasi dunia anak sehari-hari, serta memeriksa kaidah Pilihan Ganda tanpa tanda tanya (?).';
        updateBadges();
      }
    }

