      if (!soal) return;

      document.getElementById('edit_soalId').value = soal.id;
      document.getElementById('edit_nomorSoal').value = soal.nomor_soal;
      document.getElementById('edit_levelKognitif').value = soal.level_kognitif;
      document.getElementById('edit_bobot').value = soal.bobot;
      document.getElementById('edit_indikator').value = soal.indikator_soal;
      document.getElementById('edit_batangSoal').value = soal.batang_soal;
      document.getElementById('edit_opsiA').value = soal.pilihan?.A || '';
      document.getElementById('edit_opsiB').value = soal.pilihan?.B || '';
      document.getElementById('edit_opsiC').value = soal.pilihan?.C || '';
      document.getElementById('edit_opsiD').value = soal.pilihan?.D || '';
      document.getElementById('edit_kunci').value = soal.kunci_jawaban;
      document.getElementById('edit_kesulitan').value = soal.tingkat_kesulitan;
