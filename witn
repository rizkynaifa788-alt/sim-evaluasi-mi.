    function getMILanguageGuidance(kelasString) {
      const k = (kelasString || '').toUpperCase();
      if (k.includes('KELAS I ') || k.includes('KELAS II ') || k.includes('FASE A')) {
        return `KHUSUS FASE A (KELAS 1–2 MI, USIA 6–8 TAHUN):
- Gunakan kalimat yang SANGAT PENDEK, sederhana, dan langsung pada inti (maksimal 1 sampai 2 kalimat pendek per soal, sekitar 8–18 kata).
- Gunakan kosakata konkret yang sangat akrab bagi anak kecil (contoh: kegiatan bersama ayah, ibu, kakak, adik di rumah, belajar bersama ibu guru, bermain dengan teman di halaman madrasah).
