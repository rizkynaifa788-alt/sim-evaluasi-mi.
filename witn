    function saveEditedQuestion() {
      const id = document.getElementById('edit_soalId').value;
      const soal = DB.BANK_SOAL.find(s => s.id === id);
      if (!soal) return;

      soal.nomor_soal = parseInt(document.getElementById('edit_nomorSoal').value) || soal.nomor_soal;
      soal.level_kognitif = document.getElementById('edit_levelKognitif').value;
      soal.bobot = parseFloat(document.getElementById('edit_bobot').value) || 10;
      soal.indikator_soal = document.getElementById('edit_indikator').value.trim();
      soal.batang_soal = document.getElementById('edit_batangSoal').value.trim();
      soal.pilihan = {
        A: document.getElementById('edit_opsiA').value.trim(),
        B: document.getElementById('edit_opsiB').value.trim(),
        C: document.getElementById('edit_opsiC').value.trim(),
        D: document.getElementById('edit_opsiD').value.trim()
      };
      soal.kunci_jawaban = document.getElementById('edit_kunci').value.trim();
      soal.tingkat_kesulitan = document.getElementById('edit_kesulitan').value;
      soal.pembahasan = document.getElementById('edit_pembahasan').value.trim();

      syncRelationalQuestionTables();
      closeEditQuestionModal();
