        ...orig,
        id: 'IND-' + Date.now(),
        nomor_soal: DB.INDIKATOR.length + 1,
        updated_at: new Date().toISOString()
      };
      DB.INDIKATOR.splice(idx + 1, 0, copy);
      autoNumberKisiRows();
      showToast('Indikator berhasil diduplikasi.', 'success');
