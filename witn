    function balanceCognitiveLevels() {
      // Proporsi ramah tingkat MI (C1, C2, C3 dominan, ditambah C4 kontekstual sederhana)
      const pattern = ['C1', 'C2', 'C2', 'C3', 'C3', 'C4'];
      const total = DB.INDIKATOR.length;
      const equalBobot = Math.round((100 / Math.max(1, total)) * 10) / 10;
      DB.INDIKATOR.forEach((item, idx) => {
        item.level_kognitif = pattern[idx % pattern.length];
        item.bobot = equalBobot;
      });
      renderKisiTable();
      showToast('Distribusi level kognitif tingkat MI dan bobot nilai telah diseimbangkan.', 'success');
    }

    function validateKisiCompleteness(showBanner = true) {
      const errors = [];
      const seenNumbers = new Set();

      if (DB.INDIKATOR.length === 0) {
        errors.push('Tabel kisi-kisi masih kosong. Tambahkan minimal 1 baris indikator terlebih dahulu.');
      }

      DB.INDIKATOR.forEach((item, idx) => {
        if (!item.cp || !item.tp || !item.materi || !item.indikator_soal) {
          errors.push(`Baris ${idx + 1}: CP, TP, Materi, atau Indikator Soal masih kosong.`);
        }
        if (item.indikator_soal && item.indikator_soal.trim().length < 15) {
          errors.push(`Baris ${idx + 1}: Rumusan indikator soal terlalu pendek (harus memuat kompetensi/stimulus).`);
        }
        if (seenNumbers.has(item.nomor_soal)) {
          errors.push(`Baris ${idx + 1}: Nomor soal ${item.nomor_soal} duplikat.`);
        }
        seenNumbers.add(item.nomor_soal);
      });

      const banner = document.getElementById('kisiValidationBanner');
      if (showBanner) {
        banner.classList.remove('hidden');
        if (errors.length === 0) {
          banner.className = 'rounded-xl p-4 border bg-emerald-50 border-emerald-200 text-emerald-900 text-xs';
          banner.innerHTML = `<div class="font-bold mb-1"><i class="fa-solid fa-circle-check text-emerald-600 mr-1.5"></i>Kisi-Kisi MI Lengkap dan Valid!</div>Seluruh ${DB.INDIKATOR.length} indikator memiliki CP, TP, Materi, Level Kognitif, dan Nomor Soal yang unik. Siap di-generate oleh AI menjadi soal ramah anak MI.`;
        } else {
          banner.className = 'rounded-xl p-4 border bg-red-50 border-red-200 text-red-900 text-xs';
          banner.innerHTML = `<div class="font-bold mb-1"><i class="fa-solid fa-circle-xmark text-red-600 mr-1.5"></i>Ditemukan ${errors.length} Catatan pada Kisi-Kisi:</div><ul class="list-disc pl-5 space-y-0.5">${errors.map(e => `<li>${e}</li>`).join('')}</ul>`;
        }
      }
      return errors.length === 0;
    }

