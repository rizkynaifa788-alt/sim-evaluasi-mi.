    function importKisiExcel(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = new Uint8Array(e.target.result);
          const workbook = XLSX.read(data, { type: 'array' });
          const sheetName = workbook.SheetNames[0];
          const rows = XLSX.utils.sheet_to_json(workbook.Sheets[sheetName]);
          if (rows.length > 0) {
            DB.INDIKATOR = rows.map((r, i) => ({
              id: r.id || ('IND-IMP-' + (i + 1)),
              kisi_id: 'KISI-001',
              no_urut: i + 1,
              cp: r.cp || r['Capaian Pembelajaran'] || DB.IDENTITAS_MADRASAH[0]?.cp || '',
              tp: r.tp || r['Tujuan Pembelajaran'] || DB.IDENTITAS_MADRASAH[0]?.tp || '',
              materi: r.materi || r['Materi'] || 'Materi Pokok MI',
              indikator_soal: r.indikator_soal || r['Indikator Soal'] || 'Disajikan pernyataan sederhana...',
              level_kognitif: r.level_kognitif || r['Level Kognitif'] || 'C2',
              bentuk_soal: r.bentuk_soal || r['Bentuk Soal'] || 'Pilihan Ganda',
              nomor_soal: Number(r.nomor_soal || r['Nomor Soal'] || (i + 1)),
              bobot: Number(r.bobot || r['Bobot'] || 10),
              updated_at: new Date().toISOString()
            }));
            renderKisiTable();
            showToast(`Berhasil mengimpor ${DB.INDIKATOR.length} baris indikator MI dari Excel!`, 'success');
          }
        } catch (err) {
          showToast('Format file Excel tidak dikenali.', 'error');
        }
      };
      reader.readAsArrayBuffer(file);
    }

