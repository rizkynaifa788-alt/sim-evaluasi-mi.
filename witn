    /* ==========================================
       MODUL 5: PAKET UJIAN & PENGACAKAN OPSI + UPDATE KUNCI OTOMATIS
       ========================================== */
    function createNewExamPackage(packageName = 'PAKET A (UTAMA)', silent = false) {
      if (DB.BANK_SOAL.length === 0) {
        if (!silent) showToast('Bank Soal masih kosong. Silakan Generate Soal dari Kisi-Kisi terlebih dahulu.', 'warning');
        return;
      }

      const pkgId = 'PKG-' + Date.now();
      const idm = DB.IDENTITAS_MADRASAH[0];
      const pkg = {
        id: pkgId,
        nama_paket: packageName,
        mapel: idm.mapel,
        kelas: idm.kelas,
        waktu: idm.alokasi_waktu,
        petunjuk: '1. Bacalah basmalah dan berdoalah sebelum mulai mengerjakan soal. 2. Tulislah nama lengkap dan nomor absenmu pada lembar jawaban. 3. Bacalah setiap soal dengan teliti dan pilihlah jawaban yang paling tepat.',
        created_at: new Date().toISOString()
      };

      if (silent && DB.PAKET_UJIAN.length > 0) {
        DB.PAKET_UJIAN = [pkg];
        DB.DETAIL_PAKET = [];
      } else {
        DB.PAKET_UJIAN.push(pkg);
      }

      DB.BANK_SOAL.forEach((s, idx) => {
        DB.DETAIL_PAKET.push({
          id: `DPK-${pkgId}-${idx + 1}`,
          paket_id: pkgId,
          soal_id: s.id,
          nomor_urut_paket: idx + 1,
          batang_soal: s.batang_soal,
          bentuk_soal: s.bentuk_soal,
          level_kognitif: s.level_kognitif,
          pilihan: JSON.parse(JSON.stringify(s.pilihan || {})),
          kunci_jawaban: s.kunci_jawaban,
          pembahasan: s.pembahasan,
          bobot: s.bobot
        });
      });

      activePackageId = pkgId;
      if (!silent) {
        renderPaketUjianView();
        showToast(`Paket ujian MI "${packageName}" berhasil dirakit.`, 'success');
      }
      updateBadges();
    }

    /**
     * Mengacak Urutan Pilihan Jawaban A-D Sekaligus Memperbarui Kunci Jawaban dengan Akurat
     */
    function shuffleActivePackageOptions() {
      if (!activePackageId) return;
      const items = DB.DETAIL_PAKET.filter(d => d.paket_id === activePackageId);
      let updatedCount = 0;

      items.forEach(item => {
        if (item.bentuk_soal === 'Pilihan Ganda' && item.pilihan) {
          const currentKeyLetter = String(item.kunci_jawaban).toUpperCase().trim();
          const correctText = item.pilihan[currentKeyLetter];

          const entries = [
            item.pilihan.A,
            item.pilihan.B,
            item.pilihan.C,
            item.pilihan.D
          ];

          for (let i = entries.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [entries[i], entries[j]] = [entries[j], entries[i]];
          }

          const letters = ['A', 'B', 'C', 'D'];
          const newOptions = {};
          let newKeyLetter = currentKeyLetter;

          letters.forEach((ltr, idx) => {
            newOptions[ltr] = entries[idx];
            if (entries[idx] === correctText) {
              newKeyLetter = ltr;
            }
          });

          item.pilihan = newOptions;
          item.kunci_jawaban = newKeyLetter;
          updatedCount++;
        }
      });

      renderPaketUjianView();
      addLog('SHUFFLE_OPTIONS', `Mengacak opsi jawaban A-D & memperbarui kunci jawaban otomatis pada ${updatedCount} soal PG`);
      showToast(`Opsi jawaban A–D berhasil diacak dan Kunci Jawaban telah diperbarui secara otomatis!`, 'success');
    }

    function shuffleActivePackageQuestions() {
      if (!activePackageId) return;
      const items = DB.DETAIL_PAKET.filter(d => d.paket_id === activePackageId);

      const pgItems = items.filter(i => i.bentuk_soal !== 'Uraian');
      const uraianItems = items.filter(i => i.bentuk_soal === 'Uraian');

      for (let i = pgItems.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pgItems[i], pgItems[j]] = [pgItems[j], pgItems[i]];
      }

      const combined = [...pgItems, ...uraianItems];
      combined.forEach((item, idx) => {
        item.nomor_urut_paket = idx + 1;
      });

      DB.DETAIL_PAKET = [
        ...DB.DETAIL_PAKET.filter(d => d.paket_id !== activePackageId),
        ...combined
      ];

      renderPaketUjianView();
      addLog('SHUFFLE_QUESTIONS', `Mengacak urutan penomoran soal pada paket ${activePackageId}`);
      showToast('Urutan nomor soal berhasil diacak dan dinomori ulang secara otomatis.', 'success');
    }

    function generateParallelRandomizedPackage() {
      const nextLetter = String.fromCharCode(65 + DB.PAKET_UJIAN.length);
      createNewExamPackage(`PAKET ${nextLetter} (PARALEL ACAK)`, true);
      shuffleActivePackageQuestions();
      shuffleActivePackageOptions();
      renderPaketUjianView();
      showToast(`Paket Paralel (PAKET ${nextLetter}) berhasil dibuat dengan urutan soal & opsi A–D teracak!`, 'success');
    }

