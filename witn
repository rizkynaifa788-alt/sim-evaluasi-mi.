    /* ==========================================
       MODUL 4: BANK SOAL TERPADU
       ========================================== */
    function renderBankSoal() {
      const tbody = document.getElementById('bankSoalTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      const q = (document.getElementById('bankSearchInput')?.value || '').toLowerCase();
      const level = document.getElementById('bankFilterLevel')?.value || 'ALL';
      const bentuk = document.getElementById('bankFilterBentuk')?.value || 'ALL';
      const status = document.getElementById('bankFilterStatus')?.value || 'ALL';

      const filtered = DB.BANK_SOAL.filter(item => {
        const matchQ = !q || item.batang_soal.toLowerCase().includes(q) || item.materi.toLowerCase().includes(q) || item.indikator_soal.toLowerCase().includes(q);
        const matchLvl = level === 'ALL' || item.level_kognitif === level;
        const matchBentuk = bentuk === 'ALL' || item.bentuk_soal === bentuk;
        const matchSt = status === 'ALL' || item.status_persetujuan === status;
        return matchQ && matchLvl && matchBentuk && matchSt;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="p-8 text-center text-slate-400">Tidak ada butir soal MI yang sesuai kriteria filter.</td></tr>`;
        return;
      }

      filtered.forEach(soal => {
        const valStatus = soal.validasi?.status || 'VALID';
        const isChecked = selectedBankIds.has(soal.id);
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 transition';
        tr.innerHTML = `
          <td class="p-3 text-center">
            <input type="checkbox" ${isChecked ? 'checked' : ''} onchange="toggleBankSelection('${soal.id}', this.checked)">
          </td>
          <td class="p-3 font-bold text-slate-700">${soal.nomor_soal}</td>
          <td class="p-3">
            <div class="font-semibold text-slate-800">${soal.materi}</div>
            <div class="text-[11px] text-slate-500 line-clamp-2">${soal.indikator_soal}</div>
          </td>
          <td class="p-3">
            <div class="text-slate-800 font-medium mb-1">${soal.batang_soal}</div>
            ${soal.bentuk_soal === 'Pilihan Ganda' ? `
              <div class="grid grid-cols-2 gap-1 text-[11px] text-slate-600">
                <span><strong>A.</strong> ${soal.pilihan.A}</span>
                <span><strong>B.</strong> ${soal.pilihan.B}</span>
                <span><strong>C.</strong> ${soal.pilihan.C}</span>
                <span><strong>D.</strong> ${soal.pilihan.D}</span>
              </div>
            ` : ''}
          </td>
          <td class="p-3">
            <span class="inline-block px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-semibold mb-1">${soal.level_kognitif}</span>
            <div class="text-[11px] text-slate-500">${soal.bentuk_soal}</div>
          </td>
          <td class="p-3 text-center">
            <div class="font-bold text-kemenag-700 text-sm">${soal.kunci_jawaban}</div>
            <div class="text-[11px] text-slate-500">Bobot: ${soal.bobot}</div>
          </td>
          <td class="p-3 text-center">
            <span class="px-2 py-0.5 rounded-full text-[11px] font-bold ${valStatus === 'VALID' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">${valStatus}</span>
          </td>
          <td class="p-3 text-center">
            <div class="flex items-center justify-center gap-1">
              <button onclick="openEditQuestionModal('${soal.id}')" class="p-1.5 rounded bg-slate-100 hover:bg-slate-200 text-slate-700"><i class="fa-solid fa-pen"></i></button>
              <button onclick="duplicateQuestion('${soal.id}')" class="p-1.5 rounded bg-blue-50 hover:bg-blue-100 text-blue-600"><i class="fa-solid fa-copy"></i></button>
              <button onclick="deleteQuestion('${soal.id}')" class="p-1.5 rounded bg-red-50 hover:bg-red-100 text-red-600"><i class="fa-solid fa-trash"></i></button>
            </div>
