    function exportFullWorkbookExcel() {
      const wb = XLSX.utils.book_new();
      REQUIRED_17_SHEETS.forEach(sheetName => {
        const rows = (DB[sheetName] && DB[sheetName].length > 0) ? DB[sheetName] : [{ info: `Tabel ${sheetName} Siap Digunakan` }];
        const cleanRows = rows.map(r => {
          const copy = { ...r };
          if (copy.pilihan) copy.pilihan = JSON.stringify(copy.pilihan);
          if (copy.validasi) copy.validasi = JSON.stringify(copy.validasi);
          return copy;
        });
        const ws = XLSX.utils.json_to_sheet(cleanRows);
        XLSX.utils.book_append_sheet(wb, ws, sheetName.substring(0, 31));
      });
      XLSX.writeFile(wb, `Database_17_Sheet_SIM_EVALUASI_MI.xlsx`);
      addLog('EXPORT_FULL_DB', 'Mengekspor seluruh 17 Sheet Database MI ke file Workbook Excel (.xlsx)');
