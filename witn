    /**
     * Post-Processor Ketat untuk Menjamin Batang Soal PG Tanpa Tanda Tanya (?)
     */
    function enforceNoQuestionMarkOnPG(stemText, bentukSoal) {
      if (!stemText) return '';
      let clean = stemText.trim();
      if (bentukSoal === 'Pilihan Ganda' || bentukSoal === 'Pilihan Ganda Kompleks') {
        if (clean.includes('?')) {
          clean = clean.replace(/\?+/g, ' ....');
          clean = clean.replace(/^(Apa yang dimaksud dengan|Apakah yang dimaksud dengan)\s+/i, 'Arti dari ');
          clean = clean.replace(/^(Siapakah|Siapa)\s+/i, 'Nama tokoh atau orang yang ');
          clean = clean.replace(/^(Mengapa)\s+/i, 'Alasan kita harus ');
          clean = clean.replace(/^(Bagaimana)\s+/i, 'Cara yang benar untuk ');
          clean = clean.replace(/^(Berapakah|Berapa)\s+/i, 'Jumlah atau hasil dari ');
        }
        if (!clean.endsWith('.')) {
          clean = clean + ' ....';
        }
      }
      return clean;
    }

    /**
     * Sistem Pemeriksaan Kualitas Soal 11 Parameter Wajib + Keterbacaan Anak MI
     */
    function validateSingleQuestion(soal, allQuestions = []) {
      const issues = [];
      const recommendations = [];

      if (!soal.indikator_soal || soal.batang_soal.length < 15) {
        issues.push('Batang soal terlalu pendek atau belum sesuai indikator.');
        recommendations.push('Tambahkan kalimat pernyataan sederhana yang sesuai indikator kisi-kisi MI.');
      }

      // Pemeriksaan keterbacaan anak MI (kalimat tidak boleh terlalu panjang/rumit)
      const wordCount = soal.batang_soal.trim().split(/\s+/).length;
      if (wordCount > 65) {
        issues.push(`Batang soal terlalu panjang (${wordCount} kata) untuk ukuran bacaan anak tingkat MI.`);
        recommendations.push('Ringkas kalimat menjadi 1–3 kalimat sederhana agar anak MI tidak kelelahan membaca.');
      }

      if (!['C1', 'C2', 'C3', 'C4', 'C5', 'C6'].includes(soal.level_kognitif)) {
        issues.push('Level kognitif tidak terdefinisi dalam rentang C1–C6.');
      }

      if (!soal.materi || soal.materi.trim() === '') {
        issues.push('Materi pokok pada soal kosong.');
      }

      if (!soal.kunci_jawaban || String(soal.kunci_jawaban).trim() === '') {
        issues.push('Soal tidak memiliki kunci jawaban.');
        recommendations.push('Tetapkan kunci jawaban yang akurat sesuai konsep materi.');
      }

      if (soal.bentuk_soal === 'Pilihan Ganda') {
        if (soal.batang_soal.includes('?')) {
          issues.push('PELANGGARAN ATURAN PG: Batang soal Pilihan Ganda menggunakan tanda tanya (?).');
          recommendations.push('Ubah batang soal menjadi kalimat pernyataan atau perintah yang diakhiri tanda titik (....).');
        }
        const opts = soal.pilihan || {};
        if (!opts.A || !opts.B || !opts.C || !opts.D) {
          issues.push('Pilihan jawaban A, B, C, dan D belum lengkap 4 opsi.');
          recommendations.push('Lengkapi keempat pilihan jawaban A, B, C, dan D.');
        } else {
          const vals = [opts.A.trim(), opts.B.trim(), opts.C.trim(), opts.D.trim()];
          const uniqueVals = new Set(vals.map(v => v.toLowerCase()));
          if (uniqueVals.size < 4) {
            issues.push('Terdapat pilihan pengecoh yang kembar/identik pada opsi A–D.');
            recommendations.push('Pastikan setiap opsi A, B, C, dan D berbeda dan mudah dipahami anak MI.');
          }
          if (vals.some(v => /semua jawaban benar|semua salah/i.test(v))) {
            issues.push('Terdapat opsi jawaban yang ambigu ("Semua jawaban benar/salah").');
            recommendations.push('Ganti dengan pilihan jawaban yang konkret dan setara panjangnya.');
          }
        }
        if (!['A', 'B', 'C', 'D'].includes(String(soal.kunci_jawaban).toUpperCase().trim())) {
          issues.push('Kunci jawaban Pilihan Ganda harus berupa salah satu huruf A, B, C, atau D.');
        }
      }

      const duplicate = allQuestions.find(q => q.id !== soal.id && q.batang_soal.trim().toLowerCase() === soal.batang_soal.trim().toLowerCase());
      if (duplicate) {
        issues.push(`Batang soal terdeteksi duplikat dengan soal Nomor ${duplicate.nomor_soal}.`);
        recommendations.push('Regenerate atau ubah contoh cerita pada batang soal.');
      }

      let status = 'VALID';
      if (issues.some(i => i.includes('PELANGGARAN ATURAN PG') || i.includes('tidak memiliki kunci'))) {
        status = 'TIDAK VALID';
      } else if (issues.length > 0) {
        status = 'PERLU REVISI';
      }

      return {
        status,
        issues,
        recommendations: recommendations.length > 0 ? recommendations : ['Soal telah memenuhi 11 parameter kualitas & ramah dibaca anak tingkat MI.']
      };
    }

    /**
     * Memanggil Gemini API (atau Backend Google Apps Script) Khusus Bahasa Anak MI
     */
    async function callGeminiAPIForQuestions(indicatorsToGenerate) {
      const idm = DB.IDENTITAS_MADRASAH[0];

      if (isGasEnvironment) {
        return new Promise((resolve, reject) => {
          google.script.run
            .withSuccessHandler(res => resolve(res))
            .withFailureHandler(err => reject(err))
            .generateQuestionsFromKisiServer(idm, indicatorsToGenerate);
        });
      }

      if (gasWebAppUrl && !runtimeApiKey) {
        const res = await fetch(gasWebAppUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ action: 'GENERATE_QUESTIONS', identitas: idm, indicators: indicatorsToGenerate })
        });
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        return data.result;
      }

      const miGuidance = getMILanguageGuidance(idm.kelas);

      const systemPrompt = `Anda adalah Guru Teladan Madrasah Ibtidaiyah (MI) dan Ahli Evaluasi Pendidikan Dasar Kementerian Agama RI.
Tugas Anda adalah menghasilkan butir soal ujian yang SANGAT MUDAH DIPAHAMI OLEH ANAK TINGKAT MADRASAH IBTIDAIYAH (MI / SD usia 6–12 tahun) berdasarkan daftar indikator kisi-kisi yang diberikan.

ATURAN BAHASA KHUSUS ANAK TINGKAT MI (WAJIB DITAATI):
${miGuidance}
- Gunakan kata-kata yang sederhana, akrab di telinga anak-anak, kalimat pendek, tidak berbelit-belit, dan langsung dipahami saat pertama kali dibaca anak MI.
- DILARANG menggunakan istilah abstrak/akademis tingkat tinggi (seperti "implementasi", "signifikansi", "komprehensif", "paradigma", "determinasi", "konsekuensi", "konstruktif", dll). Gantilah dengan kata sehari-hari seperti "contoh perbuatan", "manfaat", "akibat", "cara yang baik", "sikap yang benar".
- Pembahasan jawaban juga harus ditulis dengan bahasa yang lembut, jelas, dan mudah dimengerti oleh siswa MI.

ATURAN MUTLAK PENULISAN SOAL PILIHAN GANDA:
1. Batang soal Pilihan Ganda WAJIB menggunakan kalimat pernyataan atau kalimat perintah yang diakhiri tanda titik-titik (....) atau titik (.).
2. DILARANG KERAS menggunakan tanda tanya (?) pada batang soal Pilihan Ganda maupun Pilihan Ganda Kompleks.
3. Contoh yang benar untuk anak MI:
   - "Sebelum makan bersama keluarga, Ahmad selalu membaca doa. Sikap Ahmad menunjukkan rasa syukur kepada ...."
   - "Ibu membeli 12 buah apel, lalu diberikan kepada adik 4 buah. Sisa buah apel Ibu sekarang adalah ...."
   - "Bagian tumbuhan yang berada di dalam tanah dan berguna untuk menyerap air adalah ...."
4. Pilihan jawaban A, B, C, D harus singkat, seimbang panjangnya, masuk akal bagi anak MI, hanya ada satu jawaban paling tepat, dan tidak boleh menggunakan opsi "Semua jawaban benar".`;

      const userPrompt = `Buatlah tepat ${indicatorsToGenerate.length} butir soal tingkat Madrasah Ibtidaiyah (MI) dengan bahasa yang ramah dan mudah dipahami anak ${idm.kelas} sesuai daftar indikator berikut:
Madrasah Ibtidaiyah: ${idm.nama_madrasah}
Mata Pelajaran MI: ${idm.mapel}
Kelas/Fase MI: ${idm.kelas}
Jenis Penilaian: ${idm.jenis_penilaian}
Kurikulum: ${idm.kurikulum}

DAFTAR INDIKATOR KISI-KISI:
${JSON.stringify(indicatorsToGenerate.map(ind => ({
  indikator_id: ind.id,
  nomor_soal: ind.nomor_soal,
  cp: ind.cp,
  tp: ind.tp,
  materi: ind.materi,
  indikator_soal: ind.indikator_soal,
  level_kognitif: ind.level_kognitif,
  bentuk_soal: ind.bentuk_soal,
  bobot: ind.bobot
})), null, 2)}`;

      const payload = {
        contents: [{ role: 'user', parts: [{ text: userPrompt }] }],
        systemInstruction: { parts: [{ text: systemPrompt }] },
        generationConfig: {
          responseMimeType: "application/json",
          responseSchema: {
            type: "ARRAY",
            items: {
              type: "OBJECT",
              properties: {
                indikator_id: { type: "STRING" },
                nomor_soal: { type: "INTEGER" },
                materi: { type: "STRING" },
                indikator_soal: { type: "STRING" },
                level_kognitif: { type: "STRING" },
                bentuk_soal: { type: "STRING" },
                tingkat_kesulitan: { type: "STRING" },
                batang_soal: { type: "STRING" },
                opsi_a: { type: "STRING" },
                opsi_b: { type: "STRING" },
                opsi_c: { type: "STRING" },
                opsi_d: { type: "STRING" },
                kunci_jawaban: { type: "STRING" },
                pembahasan: { type: "STRING" },
                bobot: { type: "NUMBER" }
              },
              required: ["indikator_id", "nomor_soal", "batang_soal", "kunci_jawaban", "pembahasan"]
            }
          }
        }
      };

      const apiKey = runtimeApiKey || "";
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const delays = [1000, 2000, 4000];
      for (let attempt = 0; attempt <= delays.length; attempt++) {
        try {
          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (!response.ok) throw new Error(`Koneksi API AI gagal (HTTP ${response.status}). Pastikan API Key telah dikonfigurasi di menu 7.`);
          const result = await response.json();
          const jsonText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
          if (!jsonText) throw new Error('Respons AI kosong atau batas kuota tercapai.');
          return JSON.parse(jsonText);
        } catch (err) {
          if (attempt === delays.length) throw err;
          await new Promise(r => setTimeout(r, delays[attempt]));
        }
      }
    }

    /**
     * Tombol Utama: GENERATE SOAL DARI KISI-KISI
     */
    async function triggerFullAIGeneration() {
      const idm = DB.IDENTITAS_MADRASAH[0];
      if (!idm || !idm.nama_madrasah || !idm.mapel) {
        showToast('Harap lengkapi Identitas Madrasah Ibtidaiyah (MI) dan Mata Pelajaran terlebih dahulu.', 'warning');
        navigate('identitas');
        return;
      }

      if (!validateKisiCompleteness(true)) {
        showToast('Mohon lengkapi kisi-kisi terlebih dahulu sebelum generate soal.', 'warning');
        navigate('kisikisi');
        return;
      }

      const overlay = document.getElementById('aiLoadingOverlay');
      const progressBar = document.getElementById('aiProgressBar');
      const progressStep = document.getElementById('aiProgressStep');
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');

      progressBar.style.width = '25%';
      progressStep.textContent = `Membaca ${DB.INDIKATOR.length} indikator kisi-kisi tingkat ${idm.kelas}...`;

      try {
        progressBar.style.width = '60%';
        progressStep.textContent = `Menyusun soal dengan kosakata sederhana yang mudah dipahami siswa ${idm.kelas}...`;
        const generatedRaw = await callGeminiAPIForQuestions(DB.INDIKATOR);

        progressBar.style.width = '85%';
        progressStep.textContent = 'Memeriksa 11 parameter kualitas, keterbacaan anak MI & memastikan 0 tanda tanya (?) pada PG...';

        DB.BANK_SOAL = [];
        DB.PILIHAN_JAWABAN = [];
        DB.KUNCI_JAWABAN = [];
        DB.PEMBAHASAN = [];
        DB.VALIDASI_SOAL = [];

        generatedRaw.forEach((raw, idx) => {
          const matchedInd = DB.INDIKATOR.find(i => i.id === raw.indikator_id) || DB.INDIKATOR[idx] || DB.INDIKATOR[0];
          const soalId = 'SOAL-' + Date.now() + '-' + (idx + 1);
          const bentuk = raw.bentuk_soal || matchedInd.bentuk_soal;
          const cleanStem = enforceNoQuestionMarkOnPG(raw.batang_soal, bentuk);

          const soalObj = {
            id: soalId,
            kisi_id: DB.KISI_KISI[0]?.id || 'KISI-001',
            indikator_id: matchedInd.id,
            nomor_soal: raw.nomor_soal || matchedInd.nomor_soal,
            tahun_pelajaran: idm.tahun_pelajaran,
            semester: idm.semester,
            mapel: idm.mapel,
            kelas: idm.kelas,
            materi: raw.materi || matchedInd.materi,
            tp: matchedInd.tp,
            indikator_soal: matchedInd.indikator_soal,
            level_kognitif: raw.level_kognitif || matchedInd.level_kognitif,
            bentuk_soal: bentuk,
            tingkat_kesulitan: raw.tingkat_kesulitan || (['C4','C5','C6'].includes(matchedInd.level_kognitif) ? 'Sulit (HOTS)' : 'Mudah'),
            batang_soal: cleanStem,
            pilihan: {
              A: raw.opsi_a || '',
              B: raw.opsi_b || '',
              C: raw.opsi_c || '',
              D: raw.opsi_d || ''
            },
            kunci_jawaban: String(raw.kunci_jawaban || '').trim(),
            pembahasan: raw.pembahasan || '',
            bobot: Number(raw.bobot || matchedInd.bobot || 10),
            guru_pembuat: idm.nama_guru,
            status_persetujuan: 'DRAFT',
            created_at: new Date().toISOString()
          };

          DB.BANK_SOAL.push(soalObj);
        });

        syncRelationalQuestionTables();

        progressBar.style.width = '100%';
        addLog('GENERATE_SOAL_AI', `Berhasil menyusun dan memvalidasi ${DB.BANK_SOAL.length} butir soal ramah anak MI dari kisi-kisi`);
        showToast(`${DB.BANK_SOAL.length} butir soal ramah anak MI berhasil dihasilkan oleh AI dan divalidasi!`, 'success');
      } catch (err) {
        addLog('AI_ERROR', `Gagal generate soal: ${err.message || err}`);
        showToast(`Gagal menghasilkan soal dari AI: ${err.message || 'Periksa konfigurasi API Key di menu 7.'}`, 'error');
      } finally {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        renderGeneratedQuestions();
        updateBadges();
      }
    }

    /**
     * Sinkronisasi Tabel Relasional (`PILIHAN_JAWABAN`, `KUNCI_JAWABAN`, `PEMBAHASAN`, `VALIDASI_SOAL`)
     */
    function syncRelationalQuestionTables() {
      DB.PILIHAN_JAWABAN = [];
      DB.KUNCI_JAWABAN = [];
      DB.PEMBAHASAN = [];
      DB.VALIDASI_SOAL = [];

      DB.BANK_SOAL.forEach(soal => {
        if (soal.bentuk_soal === 'Pilihan Ganda' || soal.bentuk_soal === 'Pilihan Ganda Kompleks') {
          ['A', 'B', 'C', 'D'].forEach(kode => {
            DB.PILIHAN_JAWABAN.push({
              id: `OPT-${soal.id}-${kode}`,
              soal_id: soal.id,
              kode_opsi: kode,
              teks_opsi: soal.pilihan?.[kode] || '',
              is_kunci: String(soal.kunci_jawaban).toUpperCase() === kode
            });
          });
        }

        DB.KUNCI_JAWABAN.push({
          id: `KEY-${soal.id}`,
          soal_id: soal.id,
          nomor_soal: soal.nomor_soal,
          kunci: soal.kunci_jawaban,
          bobot: soal.bobot
        });

        DB.PEMBAHASAN.push({
          id: `EXP-${soal.id}`,
          soal_id: soal.id,
          pembahasan: soal.pembahasan
        });

        const valResult = validateSingleQuestion(soal, DB.BANK_SOAL);
        soal.validasi = valResult;
        DB.VALIDASI_SOAL.push({
          id: `VAL-${soal.id}`,
          soal_id: soal.id,
          status: valResult.status,
          catatan: valResult.issues.join('; ') || 'Lolos 11 Parameter Validasi & Keterbacaan MI',
          rekomendasi: valResult.recommendations.join('; '),
          checked_at: new Date().toISOString()
        });
      });

      saveAllToDatabase(false);
    }

    /**
     * Regenerate Satu Soal Spesifik Tanpa Menghapus Soal Lainnya
     */
    async function regenerateSingleQuestion(soalId) {
      const idx = DB.BANK_SOAL.findIndex(s => s.id === soalId);
      if (idx === -1) return;
      const currentSoal = DB.BANK_SOAL[idx];
      const ind = DB.INDIKATOR.find(i => i.id === currentSoal.indikator_id);
      if (!ind) {
        showToast('Indikator acuan tidak ditemukan pada kisi-kisi.', 'error');
        return;
      }

      showToast(`Menghubungi AI untuk menyusun ulang Soal MI Nomor ${currentSoal.nomor_soal}...`, 'info');

      try {
        const arr = await callGeminiAPIForQuestions([ind]);
        const newRaw = arr[0];
        if (!newRaw) throw new Error('Respons AI kosong');

        currentSoal.batang_soal = enforceNoQuestionMarkOnPG(newRaw.batang_soal, currentSoal.bentuk_soal);
        if (currentSoal.bentuk_soal === 'Pilihan Ganda' || currentSoal.bentuk_soal === 'Pilihan Ganda Kompleks') {
          currentSoal.pilihan = {
            A: newRaw.opsi_a || '',
            B: newRaw.opsi_b || '',
            C: newRaw.opsi_c || '',
            D: newRaw.opsi_d || ''
          };
        }
        currentSoal.kunci_jawaban = newRaw.kunci_jawaban || currentSoal.kunci_jawaban;
        currentSoal.pembahasan = newRaw.pembahasan || currentSoal.pembahasan;

        syncRelationalQuestionTables();
        renderGeneratedQuestions();
        addLog('REGENERATE_SOAL', `Me-regenerate butir soal MI Nomor ${currentSoal.nomor_soal} (${soalId})`);
        showToast(`Soal MI Nomor ${currentSoal.nomor_soal} berhasil diperbarui oleh AI.`, 'success');
      } catch (err) {
        showToast(`Gagal melakukan regenerate soal: ${err.message || 'Periksa API Key AI'}`, 'error');
      }
    }

