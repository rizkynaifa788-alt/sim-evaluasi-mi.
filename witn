    /**
     * Generator File Microsoft Word (.doc) Standar A4 dengan Dukungan Page Setup & Tabel
     */
    function downloadWordFileFromHTML(docType, contentHTML) {
      const idm = DB.IDENTITAS_MADRASAH[0] || {};
      const wordHTML = `
        <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
        <head>
          <meta charset='utf-8'>
          <title>${docType}</title>
          <!--[if gte mso 9]>
          <xml>
            <w:WordDocument>
              <w:View>Print</w:View>
              <w:Zoom>100</w:Zoom>
              <w:DoNotOptimizeForBrowser/>
            </w:WordDocument>
          </xml>
          <![endif]-->
          <style>
            @page WordSection1 {
              size: 21.0cm 29.7cm;
              margin: 2.0cm 2.0cm 2.0cm 2.0cm;
              mso-header-margin: 1.2cm;
              mso-footer-margin: 1.2cm;
            }
            div.WordSection1 { page: WordSection1; }
            body { font-family: 'Times New Roman', Times, serif; font-size: 12pt; color: #000000; line-height: 1.5; }
            table { border-collapse: collapse; width: 100%; }
            th, td { border: 1px solid #000000; padding: 5px 7px; vertical-align: top; font-size: 11.5pt; }
            .kop-border { border-bottom: 3px double #000000; padding-bottom: 8px; margin-bottom: 16px; text-align: center; }
          </style>
        </head>
        <body>
          <div class="WordSection1">
            ${contentHTML}
          </div>
        </body>
        </html>
      `;

      const blob = new Blob(['\ufeff', wordHTML], { type: 'application/msword' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const mapelClean = (idm.mapel || 'MI').replace(/[^a-zA-Z0-9_-]/g, '_');
      a.href = url;
      a.download = `${docType}_MI_${mapelClean}.doc`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);

      DB.HASIL_EKSPOR.push({
        id: 'EXP-' + Date.now(),
        jenis_dokumen: docType,
        format: 'WORD (.doc)',
        waktu: new Date().toISOString(),
        user: idm.nama_guru || 'Guru MI'
      });
      addLog('EXPORT_WORD', `Mengunduh dokumen MI ${docType} dalam format Microsoft Word (.doc)`);
      showToast(`Dokumen ${docType} berhasil diunduh dalam format Microsoft Word (.doc)!`, 'success');
    }

